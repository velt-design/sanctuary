{
  "version": "hardware_placeholders_v1_2026-01-08",
  "currency": "NZD",
  "basis": {
    "costs": "ex_gst",
    "notes": [
      "Hardware rules reference real pricebook SKUs by material_id.",
      "Material costs are sourced from the pricebook + DB overrides (not hardcoded here).",
      "Quantities are starting rules; adjust as you refine detailing standards."
