{
  "gateway": {
    "mode": "local",
    "port": 19011,
    "bind": "loopback",
    "reload": {
      "mode": "off"
    },
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      },
      "allowTailscale": false,
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "tailscale": {
      "mode": "off"
    },
    "controlUi": {
      "enabled": false
    },
    "terminal": {
      "enabled": false
    },
    "nodes": {
      "pairing": {
        "autoApproveCidrs": []
      },
      "allowCommands": [],
      "denyCommands": ["system.run"]
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/Users/sanctuary-runner/.openclaw-sanctuary-engineering/workspaces",
      "skipBootstrap": true,
      "model": "openai/gpt-5.6-sol",
      "models": {
        "openai/gpt-5.6-sol": {
          "agentRuntime": {
            "id": "codex"
          }
        }
      },
      "thinkingDefault": "high",
      "timeoutSeconds": 3900,
      "maxConcurrent": 1,
      "sandbox": {
        "mode": "off"
      },
      "subagents": {
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 1,
        "maxConcurrent": 1,
        "runTimeoutSeconds": 3600,
        "announceTimeoutMs": 120000,
        "archiveAfterMinutes": 1440,
        "requireAgentId": true
      }
    },
    "list": [
      {
        "id": "sanctuary-engineering-supervisor",
        "default": true,
        "name": "Sanctuary Engineering Lead",
        "workspace": "/Users/sanctuary-runner/.openclaw-sanctuary-engineering/workspaces/supervisor",
        "skills": [],
        "subagents": {
          "allowAgents": ["sanctuary-coding-worker", "sanctuary-code-reviewer"],
          "requireAgentId": true,
          "delegationMode": "prefer"
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": [
            "read",
            "agents_list",
            "sessions_spawn",
            "sessions_yield",
            "sessions_list",
            "sessions_history",
            "sessions_send",
            "subagents",
            "progress_card",
            "sanctuary_engineering_lane_status",
            "sanctuary_engineering_lane_cleanup",
            "sanctuary_engineering_supervision_enqueue",
            "sanctuary_engineering_supervision_claim",
            "sanctuary_engineering_supervision_attach",
            "sanctuary_engineering_supervision_reconcile",
            "sanctuary_engineering_supervision_recover",
            "sanctuary_engineering_supervision_status",
            "sanctuary_engineering_supervision_ci",
            "sanctuary_engineering_review_attach",
            "sanctuary_engineering_review_reconcile"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      {
        "id": "sanctuary-coding-worker",
        "name": "Sanctuary Coding Worker",
        "workspace": "/Users/sanctuary-runner/.openclaw-sanctuary-engineering/workspaces/worker",
        "skills": [],
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true,
          "delegationMode": "suggest"
        },
        "tools": {
          "profile": "coding",
          "alsoAllow": [
            "sanctuary_engineering_lane_status",
            "sanctuary_engineering_lane_publish"
          ],
          "exec": {
            "host": "gateway",
            "mode": "full",
            "strictInlineEval": false,
            "timeoutSec": 3600,
            "cleanupMs": 1800000,
            "applyPatch": {
              "enabled": true,
              "workspaceOnly": true,
              "allowModels": ["gpt-5.6-sol", "openai/gpt-5.6-sol"]
            }
          },
          "deny": [
            "cron",
            "memory_get",
            "memory_search",
            "web_fetch",
            "x_search",
            "image_generate",
            "music_generate",
            "video_generate"
          ],
          "elevated": {
            "enabled": false
          }
        }
      },
      {
        "id": "sanctuary-code-reviewer",
        "name": "Sanctuary Code Reviewer",
        "workspace": "/Users/sanctuary-runner/.openclaw-sanctuary-engineering/workspaces/reviewer",
        "skills": [],
        "subagents": {
          "allowAgents": [],
          "requireAgentId": true,
          "delegationMode": "suggest"
        },
        "tools": {
          "profile": "minimal",
          "alsoAllow": ["read", "sanctuary_engineering_lane_status"],
          "elevated": {
            "enabled": false
          }
        }
      }
    ]
  },
  "tools": {
    "profile": "minimal",
    "codeMode": {
      "enabled": false
    },
    "exec": {
      "host": "gateway",
      "mode": "deny"
    },
    "web": {
      "search": {
        "enabled": false
      },
      "fetch": {
        "enabled": false
      }
    },
    "elevated": {
      "enabled": false
    },
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "sanctuary-engineering-supervisor",
        "sanctuary-coding-worker",
        "sanctuary-code-reviewer"
      ]
    },
    "sessions": {
      "visibility": "tree"
    },
    "sessions_spawn": {
      "attachments": {
        "enabled": false
      }
    }
  },
  "browser": {
    "enabled": false
  },
  "channels": {},
  "hooks": {
    "enabled": false
  },
  "cron": {
    "enabled": false,
    "triggers": {
      "enabled": false
    }
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "plugins": {
    "allow": ["codex", "sanctuary-engineering-lanes"],
    "entries": {
      "codex": {
        "enabled": true,
        "config": {
          "discovery": {
            "enabled": true,
            "timeoutMs": 2500
          },
          "appServer": {
            "mode": "yolo",
            "homeScope": "agent",
            "approvalPolicy": "never",
            "sandbox": "danger-full-access",
            "approvalsReviewer": "user",
            "defaultWorkspaceDir": "/Users/sanctuary-runner/.openclaw-sanctuary-engineering/workspaces/worker",
            "clearEnv": ["CODEX_API_KEY", "OPENAI_API_KEY"]
          }
        }
      },
      "sanctuary-engineering-lanes": {
        "enabled": true,
        "config": {}
      }
    },
    "slots": {
      "memory": "none"
    }
  },
  "acp": {
    "enabled": false,
    "dispatch": {
      "enabled": false
    }
  },
  "update": {
    "channel": "stable",
    "checkOnStart": false,
    "auto": {
      "enabled": false
    }
  }
}
