{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@sp/costing": [
        "../../packages/costing/src/index.ts"
      ],
      "@sp/costing/*": [
        "../../packages/costing/src/*"
      ],
      "@sp/geometry": [
        "../../packages/geometry/src/index.ts"
      ],
      "@sp/geometry/*": [
        "../../packages/geometry/src/*"
      ],
      "@sp/quote-format": [
        "../../packages/quote-format/src/index.ts"
      ],
      "@sp/quote-format/*": [
        "../../packages/quote-format/src/*"
      ],
      "@sp/theme": [
        "../../packages/theme/src/index.ts"
      ],
      "@sp/theme/*": [
        "../../packages/theme/src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/playwright-fixture/types/**/*.ts",
    ".next/playwright-fixture/dev/types/**/*.ts",
    ".next/playwright-fixture-readiness/types/**/*.ts",
    ".next/playwright-fixture-readiness/dev/types/**/*.ts",
    ".next-staging-commercial/types/**/*.ts",
    ".next-staging-commercial/dev/types/**/*.ts",
    ".next/playwright-schedule-review/types/**/*.ts",
    ".next/playwright-schedule-review/dev/types/**/*.ts",
    ".next/playwright-overview-v2-readonly-auth/types/**/*.ts",
    ".next/playwright-overview-v2-readonly-auth/dev/types/**/*.ts",
    ".next/playwright-overview-v2-coverage/types/**/*.ts",
    ".next/playwright-overview-v2-coverage/dev/types/**/*.ts",
    ".next/playwright-overview-v2-browser/types/**/*.ts",
    ".next/playwright-overview-v2-browser/dev/types/**/*.ts",
    ".next/codex-design-booklet/types/**/*.ts",
    ".next/codex-design-booklet/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
