{
  "name": "sanctuary-background-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker.mjs --sourcemap=linked --log-level=warning",
    "start": "node dist/worker.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "once": "tsx src/cli.ts --mode once",
    "drain": "tsx src/cli.ts --mode drain",
    "reconcile": "tsx src/cli.ts --mode reconcile",
    "queue-health": "tsx src/cli.ts queue-health"
  },
  "dependencies": {
    "@sp/email-provider": "0.0.0",
    "@sp/jobs": "0.0.0",
    "@supabase/supabase-js": "^2.90.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.16"
  }
}
