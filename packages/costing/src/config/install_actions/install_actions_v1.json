{
  "version": "install_actions_v1_2026-01-08",
  "currency": "NZD",
  "basis": {
    "crew_hour_rate_ex_gst": 75.0,
    "crew_hour_rate_inc_gst": 86.25,
    "notes": [
      "Crew-hour model: contractor payout cost is based on total crew time, not crew size.",
      "All minutes are starting assumptions to be tuned over time.",
      "Multipliers apply per-action as specified; per-job overhead is handled separately."
    ]
  },
  "multipliers": {
    "access": {
      "easy": 0.9,
      "normal": 1.0,
      "hard": 1.25
    },
    "height": {
      "single_storey": 1.0,
      "two_storey": 1.25
    },
    "ground": {
      "easy": 1.0,
      "hard": 1.2,
      "notes": "Ground multiplier applies only to concrete pile actions."
    },
    "structure_type": {
      "pitched": 1.0,
      "box_perimeter": 1.1
    },
    "roof_type": {
      "pitched": 1.0,
      "low_gable": 1.15
    }
  },
  "driver_rules_reference": {
    "defaults": {
      "post_cut_height_m": 2.4,
      "rafter_spacing_mm_max": 642,
      "soffit_bracket_spacing_mm_max": 1200
    },
    "derived_quantity_rules": [
      {
        "key": "derived.rafter_count",
        "formula": "ceil(length_mm / 642) + 1",
        "notes": "Rafters counted along pergola length using max 642mm centres."
      },
      {
        "key": "derived.bracket_count",
        "formula": "if house_connection_type == 'facade' then derived.rafter_count else ceil(attachment_length_mm / 1200) + 1",
        "notes": "Soffit/fascia use max 1.2m spacing. Facade uses rafter centres (match derived.rafter_count) for v1."
      },
      {
        "key": "derived.length_m",
        "formula": "length_mm / 1000"
      },
      {
        "key": "derived.projection_m",
        "formula": "projection_mm / 1000"
      },
      {
        "key": "derived.area_m2",
        "formula": "(length_mm/1000) * (projection_mm/1000)"
      },
      {
        "key": "derived.box_perimeter_m",
        "formula": "if structure.type == 'box_perimeter' then 2*(length_m + projection_m) else 0"
      },
      {
        "key": "derived.box_corner_count",
        "formula": "if structure.type == 'box_perimeter' then 4 else 0"
      }
    ],
    "rafter_length_multiplier": {
      "key": "derived.rafter_length_multiplier",
      "recommended_function": "mult = (max(rafter_length_m, 0.1) / reference_length_m) ** exponent",
      "reference_length_m": 3.0,
      "exponent": 0.25,
      "notes": "Gentle scaling; at 6m gives ~1.19\u00d7. Use rafter_length_m derived from geometry (+ any overhang)."
    }
  },
