  "rules": [
    {
      "id": "rule.deck_bracket_hardware",
      "applies_when": {
        "post_connection_type": "deck_bracket"
      },
      "lines": [
        {
          "item_id": "hardware.deck_bracket_assembly",
          "qty": "post_count"
        }
      ],
      "notes": "Per post deck bracket assembly cost includes a fixings allowance. Replace with exact bracket SKU pricing later."
    },
    {
      "id": "rule.slab_anchors",
      "applies_when": {
        "post_connection_type": "slab_anchors"
      },
      "lines": [
        {
          "item_id": "hardware.slab_base_plate",
          "qty": "post_count"
        },
        {
          "item_id": "anchor.chem_m12_each",
          "qty": "post_count * 4"
        }
      ],
      "notes": "Assumes 4 x M12 chemical anchors per post base."
    },
    {
      "id": "rule.soffit_bracket_fixings",
      "applies_when": {
        "house_connection_type": "soffit"
      },
      "lines": [
        {
          "item_id": "fixing.coach_screw_m10_each",
          "qty": "bracket_count * 4"
        }
      ],
      "notes": "Assumes timber fixing: 4 coach screws per bracket."
    },
    {
      "id": "rule.fascia_bracket_fixings",
      "applies_when": {
        "house_connection_type": "fascia"
      },
      "lines": [
        {
          "item_id": "fixing.coach_screw_m10_each",
          "qty": "stringer_fixing_count * 2"
        }
      ],
      "notes": "Assumes direct timber fixing: 2 coach screws per stringer fixing point."
    },
    {
      "id": "rule.facade_bracket_fixings",
      "applies_when": {
        "house_connection_type": "facade"
      },
      "lines": [
        {
          "item_id": "fixing.coach_screw_m10_each",
          "qty": "stringer_fixing_count * 2"
        }
      ],
      "notes": "Assumes direct timber fixing: 2 coach screws per stringer fixing point. If masonry fixing is needed, add a dedicated subtype later."
    },
    {
      "id": "rule.rafter_fixings",
      "applies_when": {},
      "lines": [
        {
          "item_id": "fixing.structural_screw_each",
          "qty": "total_rafter_pieces * 8"
        }
      ],
      "notes": "Assumes 8 structural screws per rafter (4 each end). Tune later."
    },
    {
      "id": "rule.acrylic_joiner_fixings",
      "applies_when": {
        "roof_material": "acrylic"
      },
      "lines": [
        {
          "item_id": "fixing.joiner_screw_each",
          "qty": "joiner_runs_total * 6"
        }
      ],
      "notes": "Acrylic joiner system fixings placeholder: assumes 6 screws per joiner run. Re-measure and replace with exact SKU quantities later."
    },
    {
      "id": "rule.mixed_joiner_fixings",
      "applies_when": {
        "roof_material": "mixed"
      },
      "lines": [
        {
          "item_id": "fixing.joiner_screw_each",
          "qty": "(acrylic_bays_total + acrylic_plane_count_used) * 6"
        }
      ],
      "notes": "Mixed roof joiner system fixings placeholder: assumes 6 screws per joiner run. Re-measure and replace with exact SKU quantities later."
    },
    {
      "id": "rule_sealants",
      "applies_when": {},
      "lines": [
        {
          "item_id": "consumable.silicone_tube",
          "qty": "2"
        },
        {
          "item_id": "consumable.alcohol_wipes_pack",
          "qty": "1"
        },
        {
          "item_id": "consumable.misc_allowance_job",
          "qty": "1"
        }
      ],
      "notes": "Baseline consumables per job. Replace with more explicit line items if you prefer."
    }
  ]
}
