# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
apps/**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/playwright/.auth/
/artifacts/portal-project-mutation-performance.json
/artifacts/portal-workbench-performance.json

# next.js
/.next/
apps/**/.next/
/out/
apps/**/out/

# production
/build
apps/**/dist/

# misc
.DS_Store
*.pem
/tmp/running-jobs-legacy/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# sqlite db files
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
