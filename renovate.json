{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    "security:minimumReleaseAgeNpm"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "timezone": "Australia/Sydney",
  "schedule": [
    "after 8pm on friday",
    "before 6am on monday"
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "automerge": false,
  "packageRules": [
    {
      "description": "Require an explicit dashboard choice before major upgrades",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group non-major GitHub Actions maintenance",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions maintenance"
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "schedule": [
      "at any time"
    ]
  }
}
