{
  "version": "v1.5",
  "currency": "NZD",
  "basis": {
    "crew_hour_rate_ex_gst": 110.0,
    "crew_hour_rate_inc_gst": 126.5,
    "notes": [
      "Crew-hour model: contractor payout cost is based on total crew time, not crew size.",
      "All minutes are starting assumptions to be tuned over time.",
      "Multipliers apply per-action as specified; per-job overhead is handled separately."
    ]
  },
  "multipliers": {
    "access": {
      "easy": 0.9,
      "normal": 1.0,
      "hard": 1.25
    },
    "height": {
      "single_storey": 1.0,
      "two_storey": 1.25
    },
    "ground": {
      "easy": 1.0,
      "hard": 1.2,
      "notes": "Ground multiplier applies only to concrete pile actions."
    },
    "structure_type": {
      "pitched": 1.0,
      "box_perimeter": 1.1
    },
    "roof_type": {
      "pitched": 1.0,
      "low_gable": 1.15,
      "gable": 1.2,
      "hip": 1.35,
      "hip_corner": 1.35
    },
    "access_logistics": {
      "easy": 1.0,
      "normal": 1.0,
      "hard": 2.0,
      "note": "+100% (2x) time for logistics when access is hard"
    }
  },
  "driver_rules_reference": {
    "defaults": {
      "post_cut_height_m": 2.4,
      "rafter_spacing_mm_max": 642,
      "soffit_bracket_spacing_mm_max": 1500,
      "projection_includes_overhang": false,
      "stock_length_m_default": 6.0,
      "box_internal_rafter_profile_default": "80x50"
    },
    "derived_quantity_rules": [
      {
        "key": "derived.rafter_count",
        "formula": "ceil(length_mm / 642) + 1",
        "notes": "Rafters counted along pergola length using max 642mm centres."
      },
      {
        "key": "derived.bracket_count",
        "formula": "if house_connection_type == 'soffit' then ceil(attachment_length_mm / 1500) + 1 else 0",
        "notes": "Soffit bracket connection points along attachment length using max 1.5m spacing."
      },
      {
        "key": "derived.stringer_fixing_count",
        "formula": "if house_connection_type in ['fascia','facade'] then ceil(attachment_length_mm / 1500) + 1 else 0",
        "notes": "Direct stringer fixing points along attachment length for fascia/facade using max 1.5m spacing."
      },
      {
        "key": "derived.length_m",
        "formula": "length_mm / 1000"
      },
      {
        "key": "derived.projection_m",
        "formula": "projection_mm / 1000"
      },
      {
        "key": "derived.area_m2",
        "formula": "(length_mm/1000) * (projection_mm/1000)"
      },
      {
        "key": "derived.box_perimeter_m",
        "formula": "if structure.type == 'box_perimeter' then 2*(length_m + projection_m) else 0"
      },
      {
        "key": "derived.box_corner_count",
        "formula": "if structure.type == 'box_perimeter' then 4 else 0"
      },
      {
        "key": "derived.joiner_count",
        "formula": "if roof.material == 'acrylic' then derived.rafter_count else 0",
        "notes": "Joiners align to rafters; one joiner line per rafter."
      },
      {
        "key": "derived.joiner_total_m",
        "formula": "derived.joiner_count * derived.projection_m",
        "notes": "Total linear metres of joiner required (cut lengths), excluding waste."
      }
    ],
    "rafter_length_multiplier": {
      "key": "derived.rafter_length_multiplier",
      "recommended_function": "mult = clamp(0.85, 1.30, 1.0 + 0.06 * (rafter_length_m - 3.0)); rafter_length_m should be sloped rafter length (span_m / cos(pitch_deg)).",
      "reference_length_m": 3.0,
      "exponent": 0.25,
      "notes": "Use rafter_length_m = derived.projection_m (no overhang). Gentle scaling; at 6m gives ~1.19\u00d7.",
      "inputs": [
        "derived.rafter_length_m"
      ]
    }
  },
