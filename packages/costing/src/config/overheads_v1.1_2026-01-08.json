  "changelog": [
    {
      "date": "2026-01-08",
      "changes": [
        "Added multi-pergola overhead logic: overhead not simply per_job * module_count.",
        "Split overhead allocation into fixed + variable components (ops_delivery scales with crew_days; sales_design scales sub-linearly with module_count)."
      ]
    },
    {
      "date": "2026-02-19",
      "changes": [
        "Updated ops formula to 500 + 1000 * crew_days.",
        "Added startup overhead for explicit gable and box-perimeter pergolas (mutually exclusive, one startup only).",
        "Added timber daily overhead surcharge using rounded crew-days for timber and mixed roofs.",
        "Removed optional overhead cap."
      ]
    }
